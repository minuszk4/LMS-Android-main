rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerField(field) {
      return isSignedIn() && field == request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isInstructor() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'INSTRUCTOR';
    }

    function isCourseInstructor(courseId) {
      return isInstructor() &&
        exists(/databases/$(database)/documents/courses/$(courseId)) &&
        get(/databases/$(database)/documents/courses/$(courseId)).data.instructorId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    match /instructors/{instructorId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (isInstructor() && isOwnerField(resource.data.instructorId));
    }

    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /carts/{cartId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isOwnerField(request.resource.data.userId);
      allow delete: if false;
    }

    match /cartItems/{cartItemId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (
        isOwnerField(request.resource.data.userId) ||
        isOwnerField(resource.data.userId)
      );
    }

    // Payment Phase-1: allow create/read from client, but block client-side status mutation.
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        isOwnerField(resource.data.userId) &&
        request.resource.data.paymentStatus == resource.data.paymentStatus &&
        request.resource.data.confirmedAt == resource.data.confirmedAt;
      allow delete: if false;
    }

    match /orderItems/{orderItemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Sensitive payment records must be server-only.
    match /bankTransactions/{transactionId} {
      allow read, write: if false;
    }

    match /momoRequests/{requestId} {
      allow read, write: if false;
    }

    match /instructorPayouts/{payoutId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /progress/{progressId} {
      allow read, write: if isSignedIn();
    }

    match /lessonProgress/{progressId} {
      allow read, write: if isSignedIn();
    }

    match /quizProgress/{progressId} {
      allow read, write: if isSignedIn();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    match /chatSessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    match /chatMessages/{messageId} {
      allow read, write: if isSignedIn();
    }

    // Unknown collections are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
